configuration {
    modi: "drun,run";
    case-sensitive: false;
    cycle: true;
    filter: "";
    scroll-method: 0;
    normalize-match: true;
    show-icons: true;
    icon-theme: "Papirus";
    
    display-drun: "App";
    display-run: "Run";
    
    drun-display-format: "{icon} {name}";
}

* {
    bg: #0a0a0f;
    col: #cdd6f4;
    bord: #7a88cf;
    
    sel-bg: #5c6b8f;
    sel-fg: #0a0a0f;

    background-color: transparent;
    text-color: @col;
    font: "JetBrainsMono Nerd Font 12";
    margin: 0px;
    padding: 0px;
    spacing: 0px;
}

window {
    location: center;
    width: 30%;
    height: 20%;
    
    background-color: @bg;
    border: 2px;
    border-color: @bord;
    border-radius: 20px;
}

mainbox {
    padding: 0px;
}

inputbar {
    background-color: transparent;
    text-color: @col;
    border: 0px 0px 1px 0px;
    border-color: @bord;
    border-radius: 20px 20px 0px 0px;
    padding: 10px 25px;
    children: [ prompt, entry ];
}

prompt {
    text-color: @col;
    margin: 0px 10px 0px 0px;
}

entry {
    placeholder: "Search...";
    placeholder-color: #585b70;
    text-color: @col;
}

listview {
    background-color: transparent;
    margin: 10px 0px 0px 0px;
    padding: 0px;
    columns: 1;
    scrollbar: false;
}

element {
    padding: 8px 10px;
    margin: 2px 10px;
    border-radius: 10px;
    background-color: transparent;
    text-color: @col;
}

element selected {
    background-color: @sel-bg;
    text-color: @sel-fg;
}

element-icon {
    size: 24px;
    vertical-align: 0.5;
    margin: 0px 10px 0px 0px;
}

element-text {
    vertical-align: 0.5;
}
